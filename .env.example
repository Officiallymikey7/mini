# Environment variables for the Minecraft Agent Framework
# ─────────────────────────────────────────────────────────
# Copy this file to .env, then fill in real values.
# NEVER commit .env to version control.

# OpenAI API key (required for LLM-assisted planning)
OPENAI_API_KEY=your-openai-api-key-here

# Agent tick interval in milliseconds (default: 5000)
AGENT_TICK_MS=5000

# Enable governance checks every N ticks (default: 10)
GOVERNANCE_TICK_INTERVAL=10

# Log level: debug | info | warn | error
LOG_LEVEL=info
